# Database (Supabase)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Authentication (JWT)
JWT_SECRET=your-secure-jwt-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Redirect URI (Sent to Google OAuth and used in token exchange)
# Local Example: http://localhost:3000/api/auth/google/callback
# Production Example: https://certify-zip.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://certify-zip.vercel.app/api/auth/google/callback

# Application Frontend URL (Used for post-login redirects, CORS, and password resets)
# Local Example: http://localhost:3000
# Production Example: https://certify-zip.vercel.app
FRONTEND_URL=https://certify-zip.vercel.app
APP_URL=https://certify-zip.vercel.app

# Optional CORS and Cookie Domain
# CORS_ORIGIN=https://certify-zip.vercel.app
# COOKIE_DOMAIN=.vercel.app

# Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key

