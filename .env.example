# Browser and server Auth clients (public; bundled at build time by Next.js).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only: storage and gmail_tokens. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=your-service-role-key
# Separate Gmail/Sheets OAuth Web application credentials.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
APP_URL=https://your-app.example
# Optional override; authorize this exact callback in Google Cloud.
GOOGLE_REDIRECT_URI=https://your-app.example/api/auth/gmail/callback
