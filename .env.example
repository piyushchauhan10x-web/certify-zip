# Required for Supabase Auth (public URL and anon/publishable key ONLY).
# Read at request time through /api/auth/config; never put a service key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only: storage and gmail_tokens access.
SUPABASE_SERVICE_KEY=your-service-role-key
APP_URL=https://your-app.example
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optional fallback: both values and a domain verified in Resend are required.
RESEND_API_KEY=
EMAIL_FROM=
# Vercel supplies this fallback automatically; no manual setting usually needed.
# VERCEL_PROJECT_PRODUCTION_URL=your-app.vercel.app
# NODE_ENV is managed by Next.js. Do not set it manually in Vercel.
