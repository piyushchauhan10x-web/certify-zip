# Supabase (server only). Apply supabase/migrations/202610060001_auth_schema.sql.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
JWT_SECRET=replace-with-a-long-random-secret
# Required: no built-in session signing secret. Changing it logs everyone out.

# Google OAuth: same Web application client for login and token refresh.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optional overrides. Without APP_URL, use request headers then Vercel's production host.
APP_URL=https://your-app.example
GOOGLE_REDIRECT_URI=https://your-app.example/api/auth/google/callback
# Also authorize https://your-app.example/api/auth/gmail/callback in Google Cloud.
# Vercel normally provides this automatically; hostname only, no protocol.
# VERCEL_PROJECT_PRODUCTION_URL=certify-zip.vercel.app
# Session and OAuth cookies are host-only.
# Optional CORS origin, if required by your deployment.
# CORS_ORIGIN=https://your-production-host.example

# Optional Resend for password reset. Use a verified domain for EMAIL_FROM.
RESEND_API_KEY=re_replace-me
EMAIL_FROM=Certify <certificates@your-verified-domain.example>
